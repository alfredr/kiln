# Standard numbering definitions
#
# Defines hierarchical section numbering and flat figure numbering.
# Heading numbers are prepended automatically via @content.
#
# Parameters:
#   format  — number format tokens per depth, e.g. ["I","1"] for Roman/Arabic
#   content — template prepended to headings, e.g. "{number}. "

@def(numbering, format=["I","1"], content="{number}. ") {
  @var(fig, 0);
  @var(index, [0], format=@arg(format));
  @var(val, 0);

  @on(enter, section > section) {
    @pop(index, val);
    @inc(val);
    @push(index, val);
    @push(index, 0);
  }

  @on(exit, section > section) {
    @pop(index);
  }

  @on(enter, heading) {
    @pop(index, val);
    @store(number, index);
    @push(index, val);
  }

  @on(enter, figure) {
    @inc(fig);
    @store(number, fig);
  }

  @content(heading, @arg(content));
}

@use(numbering);
@init(figure, label="Figure {n}");
@init(heading, label="Section {n}");
