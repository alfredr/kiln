# Standard numbering definitions
#
# Defines hierarchical section numbering and flat figure numbering.
# Documents opt in to visible numbering with @content(heading, "{number}. ")
# or by adding numbering=true to individual elements.

@def(numbering) {
  @var(fig, 0);
  @var(index, [0], format=["I","1"]);
  @var(val, 0);

  @on(enter, section > section) {
    @pop(index, val);
    @inc(val);
    @push(index, val);
    @push(index, 0);
  }

  @on(exit, section > section) {
    @pop(index);
  }

  @on(enter, heading) {
    @pop(index, val);
    @store(number, index);
    @push(index, val);
  }

  @on(enter, figure) {
    @inc(fig);
    @store(number, fig);
  }
}

@use(numbering);
@init(figure, label="Figure {n}");
@init(heading, label="Section {n}");
